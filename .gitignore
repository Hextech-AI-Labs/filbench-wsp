# Byte-compiled / cache files
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# Virtual environments
.venv/
venv/
env/

# Secrets and tokens (NEVER COMMIT)
.env
*.pem
*.key
hf_token*

# Model checkpoints and raw tensor files (NEVER COMMIT)
checkpoints/
*.safetensors
*.bin
*.pt
*.pth
*.gguf
*.onnx

# Benchmark datasets and local caches (NEVER COMMIT)
data_cache/
hf_cache/
*.parquet
*.arrow

# Experiment outputs (keep large artifacts out of Git)
experiments/*
!experiments/.gitkeep

# External cloned repos (managed via setup script or submodule)
external/filbench-eval/

# OS / Editor files
.DS_Store
Thumbs.db
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json